{
  "name": "rokawright",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "build:standalone": "npm run build:pdf && node scripts/build-standalone.js",
    "build:pdf": "esbuild scripts/pdf-entry.js --bundle --minify --format=iife --global-name=RokaPDF --outfile=pdf-library.js",
    "build": "npm run build:pdf && node scripts/build-site.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8"
  }
}
